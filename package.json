{
  "name": "gptrouter",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligent model routing for lowest-cost adequate capability",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:validate": "npm run prisma:validate --workspace=@gptrouter/persistence",
    "prisma:generate": "npm run prisma:generate --workspace=@gptrouter/persistence",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.23.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.17.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.18.0",
    "npm": ">=10.0.0"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "pg": "^8.23.0"
  }
}
